# Knowledge layer works without these values.
# Live probe/validation tools require a read-only weclapp API token.
WECLAPP_BASE_URL=https://your-tenant.weclapp.com/webapp/api/v2
WECLAPP_API_KEY=replace-me
WECLAPP_AUTH_HEADER=AuthenticationToken

# MCP runtime. Use stdio for local CLI clients, sse for Docker/mcp-remote.
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Safety limits for production live probes.
WECLAPP_MAX_PAGE_SIZE=10
WECLAPP_REQUEST_TIMEOUT_SECONDS=30
